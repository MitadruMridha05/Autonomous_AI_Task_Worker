# LLM provider configuration (required only for a live agent run)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.llmsrelay.com

# Alternative OpenAI-compatible provider (OpenAI, Gemini, Groq, Ollama, etc.)
# LLM_PROVIDER=openai_compat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<provider model name>

# Mock app location
OPSPILOT_URL=http://127.0.0.1:8000

# Optional Day 2 chaos demo: make this many HTML refund submissions fail with 500.
# The REST API remains available as the recovery path.
# OPSPILOT_UI_REFUND_FAILURES=1
