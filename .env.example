# Copy this file to `.env` and fill in ONE provider. `.env` is git-ignored: never commit real keys.

# ---- Option A (default): Anthropic Claude ------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# If the agent gets confused on multi-step tasks, try a stronger model: claude-sonnet-5-5

# ---- Option B: any OpenAI-compatible API (OpenAI, Gemini, Groq, Ollama...) ----------
# LLM_PROVIDER=openai_compat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini example; omit for OpenAI itself
# LLM_MODEL=<model name copied from the provider's docs; it must support tool/function calling>

# ---- Mock app location (change only if you run it on another port) -------------------
OPSPILOT_URL=http://127.0.0.1:8000
